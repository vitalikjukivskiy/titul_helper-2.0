# Один зовнішній цикл = один оракул і один моб
forever
    # Використати оракул лише один раз
    send 5
    wait 150

    # Якщо гра показала вікно підтвердження — підтвердити
    send Y
    wait 1000

    # Шукати потрібного моба, доки не з’явиться контрольний колір
    while_not 819, 74, #FFFFFF, 10
        send Tab
        wait 200
    end_while

    # Бити вибраного моба, доки контрольний колір присутній
    while 819, 74, #FFFFFF, 10
        send 1
        wait 250
    end_while

    # Після смерті невелика пауза перед наступним оракулом
    wait 500
end_forever
